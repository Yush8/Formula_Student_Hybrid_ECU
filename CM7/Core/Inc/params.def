/*
 * params.def  --  THE TUNABLE PARAMETERS (the values you can change at runtime)
 *
 *  >>>>>>  THIS IS THE ONE FILE YOU EDIT TO ADD/REMOVE A TUNABLE.  <<<<<<
 *  No C knowledge needed. Exactly like can1_messages.def is for CAN and
 *  log_signals.def is for logging: add one line per parameter and EVERYTHING
 *  else follows automatically -
 *      - the firmware storage (the live value in RAM),
 *      - the built-in default it starts from,
 *      - the safe min/max it is clamped to,
 *      - the USB console (`list` / `get` / `set` / `save`),
 *      - the Config GUI (it auto-discovers whatever the board reports),
 *      - the flash save/load (stale flash is auto-rejected when this list changes).
 *  ...so none of them can ever drift out of sync.
 *
 *  ---------------------------------------------------------------------------
 *  TO ADD A PARAMETER  (one line):
 *
 *     A floating-point value (Simulink 'single'):
 *           PARAM_F32( <name>, <default>, <min>, <max> )
 *
 *     A whole-number value (Simulink int32, or a boolean as 0/1):
 *           PARAM_I32( <name>, <default>, <min>, <max> )
 *
 *     <name>     the name you type in the console and see in the GUI. If you
 *                want the model to USE this value, name it EXACTLY like the
 *                Simulink Inport and add one MODEL_PARAM(<name>) line in
 *                model_bridge.c (see that file - it is one obvious line and it
 *                stays under your control).
 *     <default>  the value the board powers up with before any `save`. Floats
 *                need an 'f' suffix (e.g. 1.5f); ints are plain (e.g. 200).
 *     <min>/<max> the safe range. The board CLAMPS to this on every `set` and
 *                on boot, so a typo or a bad flash image can never apply an
 *                out-of-range value. Use the same numeric style as the default.
 *
 *     Example - a proportional gain, default 1.5, allowed 0..100:
 *           PARAM_F32( kp, 1.5f, 0.0f, 100.0f )
 *
 *  After editing: rebuild CM7 and reflash. Then `save` once on the console (or
 *  the GUI Save button) to write the new layout to flash. That's it - the new
 *  parameter shows up in the console and the GUI automatically.
 *  ---------------------------------------------------------------------------
 *
 *  Rules / notes:
 *   - No semicolon, no comma at the end of the line (just like CAN_MSG).
 *   - Each <name> must be unique in this list (it becomes a struct field name),
 *     so it must be a valid C identifier: letters, digits, underscore; no spaces.
 *   - SAFETY-CRITICAL limits (AIR / precharge thresholds, fault trips) do NOT
 *     belong here - keep those as `const` in firmware so no console command or
 *     edited flash image can ever move them.
 *   - Changing this list changes the flash layout. You do NOT need to bump any
 *     version by hand: a layout fingerprint is stored with the saved config, so
 *     after a change the old flash is detected as stale and the board falls back
 *     to these defaults (safe). Just `save` once after reflashing.
 */

/*           name            default   min       max     */
PARAM_F32(   kp,             1.500f,   0.0f,     100.0f )
PARAM_F32(   ki,             0.200f,   0.0f,     100.0f )
PARAM_I32(   torque_limit,   200,      0,        240    )
PARAM_I32(   Parameter_1,    0,        0,        1      )

/* --- BMS power-limiter (must match the Simulink Inport names exactly) ------
 * Drive_Efficiency / BMS_Margin: max is 1.0 ON PURPOSE - >1 would size the
 *   power budget above the BMS discharge limit and defeat the limiter.
 * Motor_Torque_Max: per-wheel absolute torque cap [Nm] + stall guard. Set to
 *   the Neu 2530's real max (4.4 Nm on this LV hybrid). This value also SCALES
 *   the gearbox-protection torque slew rate (see model_bridge.c): the 0->full
 *   ramp TIME is fixed, so the Nm/s slew follows this cap automatically.
 * Left_Direction / Right_Direction: motor spin-direction multipliers, applied
 *   AFTER the limiter, so they are constrained to {-1,0,1} - magnitude can
 *   never exceed 1, so a direction value can never amplify torque past DCL.
 *   Defaults preserve the old behaviour (left negated); confirm your mounting. */
PARAM_F32(   Drive_Efficiency,  0.850f,  0.0f,   1.0f   )
PARAM_F32(   BMS_Margin,        0.900f,  0.0f,   1.0f   )
PARAM_F32(   Motor_Torque_Max,  4.4f,    0.0f,   50.0f  )
PARAM_I32(   Left_Direction,   -1,      -1,      1      )
PARAM_I32(   Right_Direction,   1,      -1,      1      )

/* --- Regen / ACL (charge) LIMITER tunables (must match the Simulink Inport
 *     names). These feed the bms_power_limit block ONLY - the SAFETY limits.
 *     The brake->regen torque CURVE (deadzone/full-scale) is NOT here: it lives
 *     in a visible Simulink lookup table in your torque-decision blocks, so the
 *     team tunes the shape in the model. These three are the safety backstops.
 * Regen_Efficiency: charge-side efficiency. Used as budget = margin*ACL*V / eff,
 *   so HIGHER is MORE conservative against ACL (the safe direction is OPPOSITE
 *   to Drive_Efficiency - do NOT reuse the 0.85). Min kept >=0.5 so a mis-set
 *   value can't balloon the charge budget. Tune ~0.95.
 * Motor_Regen_Max: per-wheel MAX regen (braking) torque MAGNITUDE [Nm] - the
 *   negative cap / backstop (independent of whatever the lookup table outputs).
 *   Set to the Neu 2530's max (4.4 Nm, same motor as drive). Sets the negative
 *   end of the drive<->regen span the torque slew ramps across (see model_bridge.c).
 * Regen_Cutoff_Speed: motor speed [turns/s] below which regen tapers to 0 (per
 *   wheel) so the motor never reverse-drives a stopped car. Not a rules floor
 *   (LV hybrid); a driveability/anti-rollback taper - keep it low. Tune on dyno. */
PARAM_F32(   Regen_Efficiency,   0.950f,  0.5f,   1.0f   )
PARAM_F32(   Motor_Regen_Max,    4.4f,    0.0f,   50.0f  )
PARAM_F32(   Regen_Cutoff_Speed, 2.0f,    0.01f,  100.0f )

/* --- Front-axle TORQUE VECTORING (Option A: steering-proportional split) ----
 *     Must match the Simulink Inport names. Splits the per-wheel base torque
 *     L/R by steering BEFORE the limiter (which then scales both wheels by one
 *     factor, so the split ratio survives the power limit). Drive torque only -
 *     no vectoring under regen braking.
 * TV_Gain: torque split per unit of steering [Nm per deg]. DEFAULT 0 = TV OFF,
 *   so the car drives exactly as before until you deliberately tune it up.
 *   Confirm the sign on a stand first, then raise slowly on a skidpad.
 * Steering_Centre: straight-ahead offset subtracted from the steering signal
 *   [steering unit, e.g. deg]. WHILE STEERING IS A CONSTANT-0 PLACEHOLDER LEAVE
 *   THIS AT 0 - with no real steering signal a non-zero centre acts as a fake
 *   steering input and would command a constant split. Set it once the steering
 *   CAN inport is wired.
 * Steering_Deadzone: no vectoring within +/- this of centre [deg] - rejects
 *   on-centre noise and small corrections.
 * Max_Torque_Split: hard cap on |delta T| [Nm] - a steering fault can never
 *   command a wider split than this. Keep <= Motor_Torque_Max. */
PARAM_F32(   TV_Gain,            0.000f,  0.0f,    2.0f   )
PARAM_F32(   Steering_Centre,    0.000f, -30.0f,   30.0f  )
PARAM_F32(   Steering_Deadzone,  2.000f,  0.0f,    20.0f  )
PARAM_F32(   Max_Torque_Split,   2.000f,  0.0f,    50.0f  )

/* --- Bench / jack VELOCITY test scaling (wheels-off, no-load spin tests) -----
 *     Must match the Simulink Inport name. ONLY has any effect when the ODrives
 *     are switched to VELOCITY_CONTROL over USB (odrivetool) for a wheels-off
 *     test. The final per-wheel torque request (after torque-vectoring AND all
 *     power/regen limits) is multiplied by this gain and streamed as a
 *     Set_Input_Vel (0x00D / 0x02D) frame [motor turns/s per Nm]. The normal
 *     torque frame keeps streaming; in velocity mode the ODrive just treats it
 *     as a torque feed-forward, so this is safe to leave wired in the race build.
 * DEFAULT 0 = velocity request is always 0, so the feature is INERT until you
 *     deliberately set it for a bench test, and a power-cycle (if unsaved)
 *     returns it to 0. Because you tap AFTER the limiter, the wheels only spin
 *     with HV + BMS live (a jacked whole-car test), not a bare ODrive+PSU bench.
 *     The ODrive's own vel_limit is the real backstop - keep this modest. */
PARAM_F32(   Vel_Scale,          0.000f,  0.0f,    50.0f  )

/* --- BENCH engine-off drive-enable BYPASS (engine-off test day) --------------
 *     Boolean. Must match the Simulink Inport name. The Safety_Supervisor holds
 *     the chain in RELAY_SWAP (State_Enum 4) until the ECU reports the engine
 *     synced (Sync State == 3), which never happens with the engine OFF. Set
 *     this true to OR that ONE gate open so the chain can advance to DRIVE
 *     (State_Enum 5) on the bench with no running engine. It bypasses ONLY the
 *     engine-sync gate - HV, precharge, APPS plausibility, the independent AIR
 *     fail-safe and the stall latch are all still live and unaffected.
 * DEFAULT 0 = normal race behaviour (real engine sync required). A power-cycle
 *     (if unsaved) returns it to 0.
 * WARNING: this is a drive-enable interlock bypass. Do NOT `save` it to flash -
 *     a saved 1 makes the car boot ready to arm the e-drive with no engine. Flip
 *     it for the test, then power-cycle (or set 0) before running for real. */
PARAM_I32(   Bench_Engine_Off,   0,       0,       1      )

/* --- BENCH speed-gate BYPASS (jacked, wheels-off spin test) ------------------
 *     Boolean. Must match the Simulink Inport name. The Option-1 anti-rollaway
 *     logic holds DRIVE torque at 0 until the car is actually ROLLING - road
 *     speed is decoded in Simulink from `vehicleSpeed`, which already rides in
 *     the APPS frame at APPS[4..5] (no new CAN). With the wheels off the ground
 *     on a jack the car never rolls, so set this true to OR that speed gate open
 *     and let the motors spin for a bench test. It bypasses ONLY the speed gate -
 *     the engine-sync gate (Bench_Engine_Off), HV, precharge, APPS plausibility,
 *     the brake-plausibility cut, the independent AIR fail-safe and the stall
 *     latch are ALL still live.
 * DEFAULT 0 = normal race behaviour (real road speed required). For a full
 *     engine-off jack test set BOTH Bench_Engine_Off and this to 1. A power-cycle
 *     (if unsaved) returns it to 0.
 * WARNING: this is a drive-enable interlock bypass. Do NOT `save` it as 1 - a
 *     saved 1 boots the car ready to spin the motors with no speed interlock.
 *     Flip it for the test, then power-cycle (or set 0) before running for real. */
PARAM_I32(   Bench_Speed_Bypass,  0,       0,       1      )

/* --- GUI / console START button (mirrors the physical PCB start button) ------
 *     Boolean. Must match the Simulink Inport name. Lets the car be put ready-to-
 *     drive from the laptop (or a `set Start_Button_GUI 1`) instead of only the
 *     PCB button. In Simulink it is simply OR'd with the physical Start_Button
 *     inport, so BOTH sources run the IDENTICAL ready-to-drive sequence and every
 *     interlock (HV, precharge, APPS plausibility, engine sync, the independent
 *     AIR fail-safe): it can REQUEST start, it can never bypass a safety gate.
 *     Fed to a boolean inport via MODEL_PARAM in model_bridge.c (int32 0/1 narrows
 *     to boolean implicitly, exactly like Bench_Engine_Off).
 * DEFAULT 0 = released. The GUI START button sends a brief PULSE (1 then back to
 *     0), so it behaves like a momentary press and can never stick "on".
 * WARNING: do NOT `save` it as 1 - a saved 1 would boot the car holding the start
 *     button. At rest it is 0, so a normal save captures 0. */
PARAM_I32(   Start_Button_GUI,   0,       0,       1      )
